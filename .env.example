# ==========================================================
# MONGODB
# ==========================================================
# Option 1: MongoDB running in Docker (default, no internet needed)
MONGODB_URI=mongodb://shrimp_app:shrimp_pass@mongodb:27017/shrimpwatch?authSource=shrimpwatch
# Option 2: MongoDB Atlas in the cloud (replace <user>, <password>, <cluster> with your own values)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shrimpwatch

# ==========================================================
# DATADOG (get these from Organization Settings -> API Keys / Application Keys)
# ==========================================================
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_here
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=shrimpwatch
# Dashboard id printed by `python -m app.cli.datadog_push` (the part after /dashboard/ in its URL); empty = link to the dashboard list
DD_DASHBOARD_ID=

# ==========================================================
# FARMER ALERT (email sent by Datadog; `python -m app.cli.datadog_push` adds the addresses to the monitors)
# ==========================================================
# Comma-separated addresses that receive the alert, e.g. farmer@example.com,manager@example.com; empty = no email
FARMER_ALERT_EMAILS=
# Public base URL of the control panel for the alert link (e.g. the Codespace's forwarded port); empty = no link
PUBLIC_BASE_URL=

# ==========================================================
# SELF-HEALING (Datadog Workflow Automation -> POST /automation/remediate)
# ==========================================================
# Shared secret the workflow sends in X-Automation-Token; empty = the endpoint is disabled.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The workflow also needs PUBLIC_BASE_URL (Datadog calls the API from its cloud); then run app.cli.datadog_push.
AUTOMATION_TOKEN=

# ==========================================================
# RUM for the control panel (Datadog -> Digital Experience -> RUM Applications -> New Application, JS)
# ==========================================================
# Both empty = no RUM. The client token is public by design (pub...), the application id is a UUID.
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true

# ==========================================================
# FARM SIMULATION
# ==========================================================
FARM_ID=farm-001
FARM_NAME=ShrimpWatch Demo Farm
NUM_PONDS=6
SIMULATOR_INTERVAL_SEC=30
API_URL=http://api:8000

PYTHONUNBUFFERED=1
