{
  // Codespaces: runs the whole stack (MongoDB, API, simulator, worker, Datadog Agent if a key is set) with Docker Compose.
  // Codespaces secrets of the repo (all optional, see "secrets" below). Without them -> local MongoDB, no Datadog.
  "name": "ShrimpWatch",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // For `gh codespace ssh/logs/cp` from a terminal
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "secrets": {
    "MONGODB_URI": {
      "description": "Optional. Atlas mongodb+srv:// URI. Leave unset to use the local MongoDB container."
    },
    "DD_API_KEY": {
      "description": "Optional. Datadog API key. Leave unset to run without the Datadog Agent."
    },
    "DD_APP_KEY": {
      "description": "Optional. Datadog application key (only needed for app.cli.datadog_push)."
    },
    "DD_SITE": {
      "description": "Optional. Datadog site, e.g. datadoghq.com or us5.datadoghq.com."
    },
    "DD_DASHBOARD_ID": {
      "description": "Optional. Dashboard id printed by app.cli.datadog_push, for the control panel's dashboard link."
    },
    "FARMER_ALERT_EMAILS": {
      "description": "Optional. Comma-separated addresses that receive the Datadog alert email."
    },
    "AUTOMATION_TOKEN": {
      "description": "Optional. Shared secret for the Datadog self-healing workflow (POST /automation/remediate)."
    },
    "DD_RUM_APPLICATION_ID": {
      "description": "Optional. Datadog RUM application id for the control panel."
    },
    "DD_RUM_CLIENT_TOKEN": {
      "description": "Optional. Datadog RUM client token for the control panel."
    }
  },
  "postCreateCommand": "pip install --user -r requirements-dev.txt",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "ShrimpWatch API",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
