{
  // Codespaces: chay ca stack (MongoDB, API, simulator, worker, Datadog Agent neu co key) bang Docker Compose.
  // Secret (Codespaces secrets cua repo): MONGODB_URI, DD_API_KEY, DD_APP_KEY, DD_SITE. Khong co -> Mongo local, khong Datadog.
  "name": "ShrimpWatch",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Cho `gh codespace ssh/logs/cp` tu terminal
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "secrets": {
    "MONGODB_URI": {
      "description": "Optional. Atlas mongodb+srv:// URI. Leave unset to use the local MongoDB container."
    },
    "DD_API_KEY": {
      "description": "Optional. Datadog API key. Leave unset to run without the Datadog Agent."
    },
    "DD_APP_KEY": {
      "description": "Optional. Datadog application key (only needed for app.cli.datadog_push)."
    },
    "DD_SITE": {
      "description": "Optional. Datadog site, e.g. datadoghq.com or us5.datadoghq.com."
    }
  },
  "postCreateCommand": "pip install --user -r requirements-dev.txt",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "ShrimpWatch API",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
