              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "1w"},
              "autoscale": false,
              "custom_unit": "%",
              "precision": 1,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "good",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:shrimpwatch.incident.detected{severity:critical,within_slo:true,$trang_trai}.as_count()"
                    },
                    {
                      "name": "total",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:shrimpwatch.incident.detected{severity:critical,$trang_trai}.as_count()"
                    }
                  ],
                  "formulas": [{"formula": "100 * good / total"}],
                  "conditional_formats": [
                    {"comparator": ">=", "value": 99, "palette": "white_on_green"},
                    {"comparator": "<", "value": 99, "palette": "white_on_red"}
