{
  "title": "ShrimpWatch - Giám sát chất lượng nước Ao nuôi tôm thẻ chân trắng",
  "description": "Giám sát 6 ao tôm: tổng quan sự cố, tình trạng từng ao (12 chỉ số tô màu theo ngưỡng), oxy và quạt nước, môi trường nước, khí độc và chất thải. Mỗi ao giữ một màu trên mọi biểu đồ; biểu đồ cảm biến theo khung thời gian chọn ở góc phải, biểu đồ đo tay hiển thị 24 giờ.",
  "template_variables": [
    {"name": "trang_trai", "prefix": "farm_id", "default": "farm-001"},
    {
      "name": "ao",
      "prefix": "pond",
      "default": "*",
      "available_values": ["*", "pond-01", "pond-02", "pond-03", "pond-04", "pond-05", "pond-06"]
    }
  ],
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "notify_list": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Tổng quan hệ thống (6 ao)",
        "show_title": true,
        "widgets": [
          {
            "id": 101,
            "definition": {
              "type": "query_value",
              "title": "Số sự cố đang xảy ra",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "5m"},
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "formulas": [{"formula": "query1"}],
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "sum:shrimpwatch.incident.active{$trang_trai,$ao}.rollup(max, 60)"
                    }
                  ],
                  "conditional_formats": [
                    {"comparator": ">", "value": 0, "palette": "white_on_red"},
                    {"comparator": "<=", "value": 0, "palette": "white_on_green"}
                  ]
                }
              ]
            },
            "layout": {"x": 0, "y": 0, "width": 3, "height": 2}
          },
          {
            "id": 104,
            "definition": {
              "type": "query_value",
              "title": "Dữ liệu gửi về / phút",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "5m"},
              "autoscale": true,
              "precision": 0,
              "custom_unit": "/phút",
              "requests": [
                {
                  "formulas": [{"formula": "query1 * 60"}],
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "aggregator": "avg",
                      "query": "sum:shrimpwatch.ingest.records{$trang_trai}.as_rate()"
                    }
                  ],
                  "conditional_formats": [{"comparator": "<", "value": 1, "palette": "white_on_red"}]
                }
              ]
            },
            "layout": {"x": 3, "y": 0, "width": 3, "height": 2}
          },
          {
            "id": 105,
            "definition": {
              "type": "timeseries",
              "title": "Ao có sự cố trong 24 giờ (mỗi cột màu = 1 ao)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [{"formula": "query1"}],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "max:shrimpwatch.incident.active{$trang_trai,$ao} by {pond}.rollup(max, 600)"
                    }
                  ],
                  "style": {"palette": "classic"},
                  "display_type": "bars"
                }
              ],
              "markers": [],
              "time": {"live_span": "1d"}
            },
            "layout": {"x": 6, "y": 0, "width": 6, "height": 2}
          }
        ]
      },
      "layout": {"x": 0, "y": 0, "width": 12, "height": 3}
    },
    {
      "id": 8,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Sự cố: đang mở và đã hồi phục trong 24 giờ",
        "show_title": true,
        "widgets": [
          {
            "id": 803,
            "definition": {
              "type": "query_value",
              "title": "Đang mở",
              "title_size": "16",
              "title_align": "left",
              "time": {"type": "live", "unit": "minute", "value": 2},
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "count_not_null(query1)"
                    }
                  ],
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "max:shrimpwatch.incident.open_minutes{$trang_trai,$ao} by {incident_id}.fill(null)"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {"x": 0, "y": 0, "width": 2, "height": 3}
          },
          {
            "id": 801,
            "definition": {
              "type": "query_table",
              "title": "Sự cố đang mở: số phút kể từ khi mở, theo trạng thái xử lý",
              "title_size": "16",
              "title_align": "left",
              "time": {"type": "live", "unit": "minute", "value": 2},
              "has_search_bar": "always",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "open",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "max:shrimpwatch.incident.open_minutes{state:open,$trang_trai,$ao} by {incident_id,pond,title,opened_at}.fill(null)"
                    },
                    {
                      "name": "investigating",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "max:shrimpwatch.incident.open_minutes{state:investigating,$trang_trai,$ao} by {incident_id,pond,title,opened_at}.fill(null)"
                    },
                    {
                      "name": "resolving",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "max:shrimpwatch.incident.open_minutes{state:resolving,$trang_trai,$ao} by {incident_id,pond,title,opened_at}.fill(null)"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "open",
                      "alias": "Mở, chưa tiếp nhận (phút)",
                      "limit": {"count": 50, "order": "desc"},
                      "conditional_formats": [{"comparator": ">=", "value": 0, "palette": "white_on_red"}]
                    },
                    {
                      "formula": "investigating",
                      "alias": "Đang điều tra (phút)",
                      "conditional_formats": [{"comparator": ">=", "value": 0, "palette": "black_on_light_yellow"}]
                    },
                    {
                      "formula": "resolving",
                      "alias": "Đang xử lý (phút)",
                      "conditional_formats": [{"comparator": ">=", "value": 0, "palette": "black_on_light_green"}]
                    }
                  ]
                }
              ],
              "custom_links": [
                {
                  "label": "Xử lý trong bảng điều khiển",
                  "link": "$PUBLIC_BASE_URL/control?ao={{pond.value}}"
                },
                {
                  "label": "Sự kiện của sự cố",
                  "link": "$DD_APP_URL/event/explorer?query=incident_id%3A{{incident_id.value}}"
                },
                {
                  "label": "Logs của ao",
                  "link": "$DD_APP_URL/logs?query=service%3Ashrimpwatch%20%40pond%3A{{pond.value}}"
                },
                {
                  "label": "Traces của ao",
                  "link": "$DD_APP_URL/apm/traces?query=service%3Ashrimpwatch%20%40pond%3A{{pond.value}}"
                }
              ]
            },
            "layout": {"x": 2, "y": 0, "width": 10, "height": 3}
          },
          {
            "id": 804,
            "definition": {
              "type": "query_value",
              "title": "Đã hồi phục trong 24 giờ",
              "title_size": "16",
              "title_align": "left",
              "time": {"type": "live", "unit": "minute", "value": 2},
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "count_not_null(query1)"
                    }
                  ],
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "max:shrimpwatch.incident.recovered_minutes{$trang_trai,$ao} by {incident_id}.fill(null)"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_gray"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {"x": 0, "y": 3, "width": 2, "height": 3}
          },
          {
            "id": 802,
            "definition": {
              "type": "query_table",
              "title": "Sự cố đã hồi phục trong 24 giờ: mở bao lâu thì hồi phục",
              "title_size": "16",
              "title_align": "left",
              "time": {"type": "live", "unit": "minute", "value": 2},
              "has_search_bar": "always",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "recovered",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "max:shrimpwatch.incident.recovered_minutes{$trang_trai,$ao} by {incident_id,pond,title,opened_at,recovered_at}.fill(null)"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "recovered",
                      "alias": "Hồi phục sau (phút)",
                      "limit": {"count": 50, "order": "desc"},
                      "conditional_formats": [{"comparator": ">=", "value": 0, "palette": "white_on_green"}]
                    }
                  ]
                }
              ],
              "custom_links": [
                {
                  "label": "Xử lý trong bảng điều khiển",
                  "link": "$PUBLIC_BASE_URL/control?ao={{pond.value}}"
                },
                {
                  "label": "Sự kiện của sự cố",
                  "link": "$DD_APP_URL/event/explorer?query=incident_id%3A{{incident_id.value}}"
                },
                {
                  "label": "Logs của ao",
                  "link": "$DD_APP_URL/logs?query=service%3Ashrimpwatch%20%40pond%3A{{pond.value}}"
                },
                {
                  "label": "Traces của ao",
                  "link": "$DD_APP_URL/apm/traces?query=service%3Ashrimpwatch%20%40pond%3A{{pond.value}}"
                }
              ]
            },
            "layout": {"x": 2, "y": 3, "width": 10, "height": 3}
          },
          {
            "id": 805,
            "definition": {
              "type": "note",
              "content": "Giống danh sách **Sự cố** trong bảng điều khiển, cập nhật mỗi 30 giây. Tên sự cố bắt đầu bằng *sự_cố* là nghiêm trọng, *cảnh_báo* là cảnh báo. Bấm vào một dòng để mở bảng điều khiển của ao (tiếp nhận, xử lý), sự kiện của sự cố, logs hoặc traces. Giờ mở và giờ hồi phục theo giờ trang trại (ngày/tháng_giờ:phút). Sự cố vừa đổi trạng thái có thể hiện ở cả hai cột trong tối đa 2 phút.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "center",
              "show_tick": false,
              "has_padding": true
            },
            "layout": {"x": 0, "y": 6, "width": 12, "height": 1}
          }
        ]
      },
      "layout": {"x": 0, "y": 3, "width": 12, "height": 7}
    },
    {
      "id": 6,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Tình trạng từng ao (ngay lúc này)",
        "show_title": true,
        "widgets": [
          {
            "id": 601,
            "definition": {
              "type": "query_table",
              "title": "Giá trị mới nhất của 12 chỉ số (kiềm, TAN, NO₂ là lần đo tay gần nhất trong 24 giờ)",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "1d"},
              "has_search_bar": "never",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "incident",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "max:shrimpwatch.incident.active{$trang_trai,$ao} by {pond}.rollup(max, 60)"
                    },
                    {
                      "name": "temp",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.temperature{$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "do",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.do{$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "ph",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.ph{$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "salinity",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.salinity{$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "orp",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.orp{$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "pump",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.pump_power{device_type:pump,$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "alk",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.alkalinity{source:manual,$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "tan",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.tan{source:manual,$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "nitrite",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.nitrite{source:manual,$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "co2",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.co2{source:derived,$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "nh3",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.nh3{source:derived,$trang_trai,$ao} by {pond}"
                    },
                    {
                      "name": "swing",
                      "data_source": "metrics",
                      "aggregator": "last",
                      "query": "avg:shrimpwatch.metric.ph_swing{source:derived,$trang_trai,$ao} by {pond}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "incident",
                      "alias": "Sự cố",
                      "limit": {"count": 10, "order": "desc"},
                      "conditional_formats": [
                        {"comparator": ">", "value": 0, "palette": "white_on_red"},
                        {"comparator": "<=", "value": 0, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "temp",
                      "alias": "Nhiệt °C",
                      "conditional_formats": [
                        {"comparator": ">", "value": 32, "palette": "white_on_yellow"},
                        {"comparator": "<", "value": 26, "palette": "white_on_yellow"},
                        {"comparator": ">=", "value": 26, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "do",
                      "alias": "DO mg/L",
                      "conditional_formats": [
                        {"comparator": "<", "value": 3, "palette": "white_on_red"},
                        {"comparator": "<", "value": 4, "palette": "white_on_yellow"},
                        {"comparator": ">=", "value": 4, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "ph",
                      "alias": "pH",
                      "conditional_formats": [
                        {"comparator": ">", "value": 8.5, "palette": "white_on_yellow"},
                        {"comparator": "<", "value": 7.5, "palette": "white_on_yellow"},
                        {"comparator": ">=", "value": 7.5, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "salinity",
                      "alias": "Mặn ppt",
                      "conditional_formats": [
                        {"comparator": "<", "value": 10, "palette": "white_on_yellow"},
                        {"comparator": ">=", "value": 10, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "orp",
                      "alias": "ORP mV",
                      "conditional_formats": [
                        {"comparator": "<", "value": 100, "palette": "white_on_yellow"},
                        {"comparator": ">=", "value": 100, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "pump",
                      "alias": "Quạt W",
                      "conditional_formats": [
                        {"comparator": "<", "value": 50, "palette": "white_on_red"},
                        {"comparator": ">=", "value": 50, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "alk",
                      "alias": "Kiềm mg/L",
                      "conditional_formats": [
                        {"comparator": "<", "value": 120, "palette": "white_on_yellow"},
                        {"comparator": ">=", "value": 120, "palette": "white_on_green"}
                      ]
                    },
                    {"formula": "tan", "alias": "TAN mg/L", "conditional_formats": [{"comparator": ">", "value": 1, "palette": "white_on_yellow"}, {"comparator": "<=", "value": 1, "palette": "white_on_green"}]},
                    {
                      "formula": "nitrite",
                      "alias": "NO₂ mg/L",
                      "conditional_formats": [
                        {"comparator": ">", "value": 1, "palette": "white_on_yellow"},
                        {"comparator": "<=", "value": 1, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "co2",
                      "alias": "CO₂ mg/L",
                      "conditional_formats": [
                        {"comparator": ">", "value": 10, "palette": "white_on_yellow"},
                        {"comparator": "<=", "value": 10, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "nh3",
                      "alias": "NH₃ mg/L",
                      "conditional_formats": [
                        {"comparator": ">", "value": 0.1, "palette": "white_on_yellow"},
                        {"comparator": "<=", "value": 0.1, "palette": "white_on_green"}
                      ]
                    },
                    {
                      "formula": "swing",
                      "alias": "Biên pH 24h",
                      "conditional_formats": [
                        {"comparator": ">", "value": 0.5, "palette": "white_on_yellow"},
                        {"comparator": "<=", "value": 0.5, "palette": "white_on_green"}
                      ]
                    }
                  ]
                }
              ]
            },
            "layout": {"x": 0, "y": 0, "width": 12, "height": 3}
          },
          {
            "id": 603,
            "definition": {
              "type": "note",
              "content": "🟩 Bình thường · 🟧 Cảnh báo, cần theo dõi · 🟥 Nguy hiểm, xử lý ngay",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "center",
              "show_tick": false,
              "has_padding": true
            },
            "layout": {"x": 0, "y": 3, "width": 12, "height": 1}
          },
          {
            "id": 602,
            "definition": {
              "type": "manage_status",
              "title": "Cảnh báo Datadog đang bật (trống = không ao nào có cảnh báo)",
              "title_size": "16",
              "title_align": "left",
              "query": "tag:shrimpwatch status:(alert OR warn)",
              "summary_type": "groups",
              "display_format": "countsAndList",
              "color_preference": "background",
              "hide_zero_counts": true,
              "show_last_triggered": true,
              "show_priority": false,
              "sort": "status,asc"
            },
            "layout": {"x": 0, "y": 4, "width": 12, "height": 3}
          }
        ]
      },
      "layout": {"x": 0, "y": 10, "width": 12, "height": 7}
    },
    {
      "id": 2,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Oxy và quạt nước: ao có đang thiếu oxy không?",
        "show_title": true,
        "widgets": [
          {
            "id": 202,
            "definition": {
              "type": "timeseries",
              "title": "DO (mg/L) - cảnh báo dưới 4, nguy hiểm dưới 3",
              "title_size": "16",
              "title_align": "left",
              "events": [{"q": "tags:service:shrimpwatch incident_event:* $ao", "tags_execution": "and"}],
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [{"formula": "query1"}],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:shrimpwatch.metric.do{$trang_trai,$ao} by {pond}.rollup(avg,30)"
                    }
                  ],
                  "style": {"palette": "classic"}
                }
              ],
              "markers": [
                {"value": "y = 3", "display_type": "error solid", "label": "DO nguy hiểm 3 mg/L"},
                {"value": "y = 4", "display_type": "warning dashed", "label": "DO cảnh báo 4 mg/L"}
              ],
              "yaxis": {"min": "0", "include_zero": true}
            },
            "layout": {"x": 0, "y": 0, "width": 6, "height": 2}
          },
          {
            "id": 303,
            "definition": {
              "type": "timeseries",
              "title": "Công suất quạt nước (W) - dưới 50 W là quạt hỏng",
              "title_size": "16",
              "title_align": "left",
              "events": [{"q": "tags:service:shrimpwatch incident_event:* $ao", "tags_execution": "and"}],
              "legend_layout": "auto",
              "requests": [
                {
