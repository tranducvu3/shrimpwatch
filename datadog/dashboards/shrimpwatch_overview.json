{
  "title": "ShrimpWatch - Giám sát chất lượng nước Ao nuôi tôm thẻ chân trắng",
  "description": "Dashboard tổng hợp cho 6 ao: nhiệt độ, DO, pH, độ kiềm, CO2, công suất quạt, sự cố. Tương ứng yêu cầu #3 (ít nhất 1 dashboard Datadog).",
  "template_variables": [
    {"name": "farm_id", "prefix": "farm_id", "default": "farm-001"},
    {"name": "pond", "prefix": "pond", "default": "*", "available_values": ["*", "pond-01", "pond-02", "pond-03", "pond-04", "pond-05", "pond-06"]},
    {"name": "device_type", "prefix": "device_type", "default": "*", "available_values": ["*", "water_node", "pump", "worker", "manual_tester"]}
  ],
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "notify_list": [],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Tổng quan hệ thống (6 ao)",
        "show_title": true,
        "widgets": [
          {
            "id": 101,
            "definition": {
              "type": "query_value",
              "title": "Sự cố ĐANG MỞ",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "10m"},
              "autoscale": true,
              "precision": 0,
              "requests": [
                {"formulas": [{"formula": "query1"}], "response_format": "scalar",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "count:shrimpwatch.incident.open{$farm_id,$pond}"}]}
              ]
            },
            "layout": {"x": 0, "y": 0, "width": 2, "height": 2}
          },
          {
            "id": 102,
            "definition": {
              "type": "query_value",
              "title": "Sự cố đã hồi phục",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "1d"},
              "autoscale": true,
              "precision": 0,
              "requests": [
                {"formulas": [{"formula": "query1"}], "response_format": "scalar",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "sum:shrimpwatch.incident.recovered{$farm_id,$pond}.as_count().rollup(sum, 86400)"}]}
              ]
            },
            "layout": {"x": 2, "y": 0, "width": 2, "height": 2}
          },
          {
            "id": 103,
            "definition": {
              "type": "query_value",
              "title": "Số lần quạt hỏng",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "1d"},
              "autoscale": true,
              "precision": 0,
              "requests": [
                {"formulas": [{"formula": "query1"}], "response_format": "scalar",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "sum:shrimpwatch.pump.failure{state:fail,$farm_id,$pond}.as_count().rollup(sum, 86400)"}]}
              ]
            },
            "layout": {"x": 4, "y": 0, "width": 2, "height": 2}
          },
          {
            "id": 104,
            "definition": {
              "type": "query_value",
              "title": "Records ingested / phút",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "5m"},
              "autoscale": true,
              "precision": 0,
              "requests": [
                {"formulas": [{"formula": "query1"}], "response_format": "scalar",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "sum:shrimpwatch.ingest.records{$farm_id}.as_rate()"}]}
              ]
            },
            "layout": {"x": 6, "y": 0, "width": 2, "height": 2}
          }
        ]
      },
      "layout": {"x": 0, "y": 0, "width": 8, "height": 2}
    },
    {
      "id": 2,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Chỉ số theo dõi theo Ao (tag pond, device_type)",
        "show_title": true,
        "widgets": [
          {
            "id": 201,
            "definition": {
              "type": "timeseries",
              "title": "Nhiệt độ (°C) - ngưỡng 26-32",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "4h"},
              "legend_layout": "auto",
              "requests": [
                {"formulas": [{"formula": "query1"}],
                 "response_format": "timeseries",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "avg:shrimpwatch.metric.temperature{$farm_id,$pond,$device_type} by {pond}.rollup(avg,30)"}],
                 "style": {"palette": "warm"}
                }
              ],
              "markers": [
                {"value": "y = 26", "display_type": "error dashed", "label": "Ngưỡng dưới 26°C"},
                {"value": "y = 32", "display_type": "error dashed", "label": "Ngưỡng trên 32°C"}
              ]
            },
            "layout": {"x": 0, "y": 0, "width": 8, "height": 2}
          },
          {
            "id": 202,
            "definition": {
              "type": "timeseries",
              "title": "DO (mg/L) - Warning dưới 4, Critical dưới 3",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "4h"},
              "legend_layout": "auto",
              "requests": [
                {"formulas": [{"formula": "query1"}],
                 "response_format": "timeseries",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "avg:shrimpwatch.metric.do{$farm_id,$pond,$device_type} by {pond}.rollup(avg,30)"}],
                 "style": {"palette": "cool"}
                }
              ],
              "markers": [
                {"value": "y = 3", "display_type": "error solid", "label": "DO critical 3 mg/L"},
                {"value": "y = 4", "display_type": "warning dashed", "label": "DO warning 4 mg/L"}
              ]
            },
            "layout": {"x": 0, "y": 2, "width": 8, "height": 2}
          },
          {
            "id": 203,
            "definition": {
              "type": "timeseries",
              "title": "pH - ngưỡng 7.5 - 8.5",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "4h"},
              "legend_layout": "auto",
              "requests": [
                {"formulas": [{"formula": "query1"}],
                 "response_format": "timeseries",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "avg:shrimpwatch.metric.ph{$farm_id,$pond,$device_type} by {pond}.rollup(avg,30)"}],
                 "style": {"palette": "classroom"}
                }
              ],
              "markers": [
                {"value": "y = 7.5", "display_type": "warning dashed", "label": "pH dưới 7.5"},
                {"value": "y = 8.5", "display_type": "warning dashed", "label": "pH trên 8.5"}
              ]
            },
            "layout": {"x": 0, "y": 4, "width": 8, "height": 2}
          }
        ]
      },
      "layout": {"x": 0, "y": 2, "width": 8, "height": 8}
    },
    {
      "id": 3,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Độ kiềm (manual) & CO2 (derived) + Quạt nước",
        "show_title": true,
        "widgets": [
          {
            "id": 301,
            "definition": {
              "type": "timeseries",
              "title": "Độ kiềm (mg CaCO3/L) - Warning dưới 120",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "1d"},
              "legend_layout": "auto",
              "requests": [
                {"formulas": [{"formula": "query1"}],
                 "response_format": "timeseries",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "avg:shrimpwatch.metric.alkalinity{source:manual,$farm_id,$pond} by {pond}"}],
                 "style": {"palette": "cool"}
                }
              ],
              "markers": [
                {"value": "y = 120", "display_type": "warning dashed", "label": "Độ kiềm warning 120"}
              ]
            },
            "layout": {"x": 0, "y": 0, "width": 4, "height": 2}
          },
          {
            "id": 302,
            "definition": {
              "type": "timeseries",
              "title": "CO2 (mg/L) - derived từ pH & độ kiềm, Warning trên 10",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "4h"},
              "legend_layout": "auto",
              "requests": [
                {"formulas": [{"formula": "query1"}],
                 "response_format": "timeseries",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "avg:shrimpwatch.metric.co2{source:derived,$farm_id,$pond} by {pond}.rollup(avg,60)"}],
                 "style": {"palette": "orange"}
                }
              ],
              "markers": [
                {"value": "y = 10", "display_type": "warning dashed", "label": "CO2 warning 10 mg/L"}
              ]
            },
            "layout": {"x": 4, "y": 0, "width": 4, "height": 2}
          },
          {
            "id": 303,
            "definition": {
              "type": "timeseries",
              "title": "Công suất quạt nước (W) - 0 = quạt hỏng",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "4h"},
              "legend_layout": "auto",
              "requests": [
                {"formulas": [{"formula": "query1"}],
                 "response_format": "timeseries",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "avg:shrimpwatch.metric.pump_power{device_type:pump,$farm_id,$pond} by {pond}.rollup(avg,30)"}],
                 "style": {"palette": "vivid"}
                }
              ]
            },
            "layout": {"x": 0, "y": 2, "width": 4, "height": 2}
          },
          {
            "id": 304,
            "definition": {
              "type": "hostmap",
              "title": "Heatmap DO theo ao",
              "title_size": "16",
              "title_align": "left",
              "requests": {
                "fill": {
                  "q": "avg:shrimpwatch.metric.do{$farm_id,$pond} by {pond}"
                }
              },
              "node_type": "host",
              "group": ["pond"],
              "scope": ["farm_id:farm-001"]
            },
            "layout": {"x": 4, "y": 2, "width": 4, "height": 2}
          }
        ]
      },
      "layout": {"x": 0, "y": 10, "width": 8, "height": 6}
    },
    {
      "id": 4,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Chỉ số mới: Độ mặn, ORP (sensor) · TAN, Nitrite (manual) · NH3, biên độ pH (derived)",
        "show_title": true,
        "widgets": [
          {
            "id": 401,
            "definition": {
              "type": "timeseries",
              "title": "Độ mặn (ppt) - Warning dưới 10",
              "title_size": "16",
              "title_align": "left",
              "time": {
                "live_span": "4h"
              },
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:shrimpwatch.metric.salinity{$farm_id,$pond,$device_type} by {pond}.rollup(avg,30)"
                    }
                  ],
                  "style": {
                    "palette": "cool"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 10",
                  "display_type": "warning dashed",
                  "label": "Độ mặn warning 10 ppt"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 2
            }
          },
          {
            "id": 402,
            "definition": {
              "type": "timeseries",
              "title": "ORP (mV) - dưới 100 = đáy ao thiếu oxy, nguy cơ H2S",
              "title_size": "16",
              "title_align": "left",
              "time": {
                "live_span": "4h"
              },
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:shrimpwatch.metric.orp{$farm_id,$pond,$device_type} by {pond}.rollup(avg,30)"
                    }
                  ],
                  "style": {
                    "palette": "purple"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 100",
                  "display_type": "warning dashed",
                  "label": "ORP warning 100 mV"
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 2
            }
          },
          {
            "id": 403,
            "definition": {
              "type": "timeseries",
              "title": "NH3 độc (mg/L) - derived từ TAN, pH, nhiệt độ - Warning trên 0.1",
              "title_size": "16",
              "title_align": "left",
              "time": {
                "live_span": "4h"
              },
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:shrimpwatch.metric.nh3{source:derived,$farm_id,$pond} by {pond}.rollup(avg,60)"
                    }
                  ],
                  "style": {
                    "palette": "warm"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 0.1",
                  "display_type": "warning dashed",
                  "label": "NH3 warning 0.1 mg/L"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 4,
              "height": 2
            }
          },
          {
            "id": 404,
            "definition": {
              "type": "timeseries",
              "title": "Biên độ pH 24h (max - min) - Warning trên 0.5",
              "title_size": "16",
              "title_align": "left",
              "time": {
                "live_span": "4h"
              },
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:shrimpwatch.metric.ph_swing{source:derived,$farm_id,$pond} by {pond}.rollup(avg,300)"
                    }
                  ],
                  "style": {
                    "palette": "orange"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 0.5",
                  "display_type": "warning dashed",
                  "label": "Biên độ pH warning 0.5"
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 2,
              "width": 4,
              "height": 2
            }
          },
          {
            "id": 405,
            "definition": {
              "type": "timeseries",
              "title": "TAN - tổng amoni (mg/L, manual test-kit)",
              "title_size": "16",
              "title_align": "left",
              "time": {
                "live_span": "1d"
              },
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:shrimpwatch.metric.tan{source:manual,$farm_id,$pond} by {pond}"
                    }
                  ],
                  "style": {
                    "palette": "cool"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 4,
              "width": 4,
              "height": 2
            }
          },
          {
            "id": 406,
            "definition": {
              "type": "timeseries",
              "title": "Nitrite NO2 (mg/L, manual test-kit) - Warning trên 1",
              "title_size": "16",
              "title_align": "left",
              "time": {
                "live_span": "1d"
              },
              "legend_layout": "auto",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "query1",
                      "data_source": "metrics",
                      "query": "avg:shrimpwatch.metric.nitrite{source:manual,$farm_id,$pond} by {pond}"
                    }
                  ],
                  "style": {
                    "palette": "grey"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 1",
                  "display_type": "warning dashed",
                  "label": "Nitrite warning 1 mg/L"
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 4,
              "width": 4,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 16,
        "width": 8,
        "height": 7
      }
    },
    {
      "id": 5,
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "Vector Search: sự cố tương tự (gợi ý xử lý từ lịch sử)",
        "show_title": true,
        "widgets": [
          {
            "id": 501,
            "definition": {
              "type": "query_value",
              "title": "Độ tương đồng cao nhất (sự cố gần nhất)",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "1d"},
              "autoscale": false,
              "precision": 3,
              "requests": [
                {"formulas": [{"formula": "query1"}], "response_format": "scalar",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "max:shrimpwatch.incident.similarity_score{$farm_id,$pond}", "aggregator": "last"}]}
              ]
            },
            "layout": {"x": 0, "y": 0, "width": 2, "height": 2}
          },
          {
            "id": 502,
            "definition": {
              "type": "timeseries",
              "title": "Độ tương đồng theo nguyên nhân gốc của sự cố cũ khớp nhất",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "requests": [
                {"formulas": [{"formula": "query1"}], "response_format": "timeseries",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "max:shrimpwatch.incident.similarity_score{$farm_id,$pond} by {pond,root_cause}"}],
                 "display_type": "line"}
              ]
            },
            "layout": {"x": 2, "y": 0, "width": 4, "height": 2}
          },
          {
            "id": 503,
            "definition": {
              "type": "query_table",
              "title": "Số lần tìm sự cố tương tự theo chế độ",
              "title_size": "16",
              "title_align": "left",
              "time": {"live_span": "1d"},
              "requests": [
                {"formulas": [{"formula": "query1"}], "response_format": "scalar",
                 "queries": [{"name": "query1", "data_source": "metrics", "query": "sum:shrimpwatch.incident.similarity_search{$farm_id,$pond} by {mode}.as_count()", "aggregator": "sum"}]}
              ]
            },
            "layout": {"x": 6, "y": 0, "width": 2, "height": 2}
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 23,
        "width": 8,
        "height": 3
      }
    }
  ]
}
